  "vocab": [
    {
      "name": "A létige · Forms of “to be”",
      "items": [
        { "hu": "létige", "en": "the verb “to be”", "note": "lét (existence) + ige (verb)" },
        { "hu": "lenni", "en": "to be (infinitive)" },
        { "hu": "van", "en": "is (base form of “to be”)" },
        { "hu": "én vagyok", "en": "I am", "kind": "phrase" },
        { "hu": "te vagy", "en": "you are (informal, one person)", "kind": "phrase" },
        { "hu": "Ön van", "en": "you are (formal, one person)", "note": "Left out with a noun or adjective: Ön tanár.", "kind": "phrase" },
        { "hu": "ő van", "en": "he / she is", "note": "Left out with a noun or adjective: András diák.", "kind": "phrase" },
        { "hu": "mi vagyunk", "en": "we are", "kind": "phrase" },
        { "hu": "ti vagytok", "en": "you are (informal, several people)", "kind": "phrase" },
        { "hu": "Önök vannak", "en": "you are (formal, several people)", "note": "Also left out with a noun or adjective", "kind": "phrase" },
        { "hu": "ők vannak", "en": "they are", "note": "Also left out with a noun or adjective", "kind": "phrase" },
        { "hu": "András diák. (no van!)", "en": "With he / she / they + a noun or adjective, van is left out", "note": "Never “András van diák.” The same goes for Ön and Önök.", "kind": "rule" }
      ]
    },
    {
