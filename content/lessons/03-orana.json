    {
      "name": "A magyarórán · In Hungarian class",
      "items": [
        {"hu": "Kérdezhetek valamit?", "en": "May I ask something?", "ro": "Pot să întreb ceva?", "kind": "phrase"},
        {"hu": "Van egy kérdésem.", "en": "I have a question.", "ro": "Am o întrebare.", "kind": "phrase"},
        {"hu": "Mit jelent az, hogy „bocsánat”?", "en": "What does “bocsánat” mean?", "ro": "Ce înseamnă „bocsánat”?", "kind": "phrase"},
        {"hu": "Hogy mondják magyarul azt, hogy „chair”?", "en": "How do you say “chair” in Hungarian?", "ro": "Cum se spune în maghiară „chair”?", "note": "Literally: how do they say in Hungarian that…", "kind": "phrase"},
        {"hu": "Tessék!", "en": "Here you are! (handing something over)", "ro": "Poftim! (când dai ceva)", "note": "Like German “bitte”", "kind": "phrase"},
        {"hu": "Köszönöm.", "en": "Thank you.", "ro": "Mulțumesc.", "kind": "phrase"},
        {"hu": "Szívesen.", "en": "You’re welcome.", "ro": "Cu plăcere.", "note": "Also: gladly", "kind": "phrase"},
        {"hu": "Világos minden?", "en": "Is everything clear?", "ro": "E totul clar?", "kind": "phrase"},
        {"hu": "Igen.", "en": "Yes.", "ro": "Da.", "kind": "phrase"},
        {"hu": "Nem.", "en": "No.", "ro": "Nu.", "kind": "phrase"},
        {"hu": "Nem tudom.", "en": "I don’t know.", "ro": "Nu știu.", "kind": "phrase"},
        {"hu": "Fogalmam sincs.", "en": "I have no idea.", "ro": "Habar n-am.", "note": "Literally: I don’t even have a concept", "kind": "phrase"},
        {"hu": "Tessék?", "en": "Pardon? Sorry? (I didn’t hear)", "ro": "Poftim? (n-am auzit)", "kind": "phrase"},
        {"hu": "Mit mondasz?", "en": "What are you saying? (informal)", "ro": "Ce spui?", "kind": "phrase"},
        {"hu": "Elnézést, nem értem.", "en": "Excuse me, I don’t understand.", "ro": "Scuzați-mă, nu înțeleg.", "kind": "phrase"},
        {"hu": "Nem értem.", "en": "I don’t understand.", "ro": "Nu înțeleg.", "kind": "phrase"}
      ]
    },
    {
      "name": "Az utcán · On the street",
      "items": [
        {"hu": "Bocsánat!", "en": "Sorry! / Excuse me!", "ro": "Pardon! / Scuze!", "kind": "phrase"},
        {"hu": "Elnézést!", "en": "Excuse me! (polite)", "ro": "Scuzați-mă!", "kind": "phrase"},
        {"hu": "Lassabban, legyen szíves!", "en": "More slowly, please! (formal)", "ro": "Mai rar, vă rog!", "kind": "phrase"},
        {"hu": "Sajnos, nem értem.", "en": "Unfortunately, I don’t understand.", "ro": "Din păcate, nu înțeleg.", "kind": "phrase"},
        {"hu": "Külföldi vagyok.", "en": "I’m a foreigner.", "ro": "Sunt străin(ă).", "kind": "phrase"},
        {"hu": "Nem beszélek magyarul.", "en": "I don’t speak Hungarian.", "ro": "Nu vorbesc maghiara.", "kind": "phrase"},
        {"hu": "Beszélsz angolul?", "en": "Do you speak English? (informal)", "ro": "Vorbești engleză?", "note": "Formal: Beszél angolul?", "kind": "phrase"}
      ]
    },
    {
      "name": "Köszönés · Greetings",
      "items": [
        {"hu": "Jó reggelt kívánok!", "en": "Good morning! (formal)", "ro": "Bună dimineața! (formal)", "note": "Literally: I wish (you) a good morning", "kind": "phrase"},
        {"hu": "Jó reggelt!", "en": "Good morning! (formal or informal)", "ro": "Bună dimineața!", "kind": "phrase"},
        {"hu": "Jó napot kívánok!", "en": "Hello! / Good day! (formal)", "ro": "Bună ziua! (formal)", "note": "The standard polite daytime hello", "kind": "phrase"},
        {"hu": "Jó napot!", "en": "Good day! (formal)", "ro": "Bună ziua!", "kind": "phrase"},
        {"hu": "Jó estét kívánok!", "en": "Good evening! (formal)", "ro": "Bună seara! (formal)", "kind": "phrase"},
        {"hu": "Jó estét!", "en": "Good evening!", "ro": "Bună seara!", "kind": "phrase"},
        {"hu": "Szia!", "en": "Hi! / Bye! (informal, to one person)", "ro": "Salut! / Pa!", "note": "Same meaning: Szervusz!", "kind": "phrase"},
        {"hu": "Szervusz!", "en": "Hi! / Bye! (informal, to one person)", "ro": "Salut! / Servus!", "note": "A bit more old-fashioned than Szia", "kind": "phrase"},
        {"hu": "Sziasztok!", "en": "Hi! / Bye! (informal, to several people)", "ro": "Salutare! / Pa! (mai multor persoane)", "note": "Same meaning: Szervusztok!", "kind": "phrase"},
        {"hu": "Szervusztok!", "en": "Hi! / Bye! (informal, to several people)", "ro": "Servus! (mai multor persoane)", "kind": "phrase"},
        {"hu": "Csókolom!", "en": "Hello! (said by children to adults, or to older women)", "ro": "Sărut mâna! (copii către adulți)", "note": "Literally: I kiss (it)", "kind": "phrase"},
        {"hu": "Kezét csókolom!", "en": "Old-fashioned polite greeting to a woman", "ro": "Sărut mâna! (formal, de modă veche)", "note": "Literally: I kiss your hand", "kind": "phrase"},
        {"hu": "Viszontlátásra!", "en": "Goodbye! (formal)", "ro": "La revedere!", "note": "Literally: until we see each other again", "kind": "phrase"},
        {"hu": "Viszlát!", "en": "Bye! (short for Viszontlátásra)", "ro": "La revedere! (scurt)", "kind": "phrase"},
        {"hu": "Jó éjszakát kívánok!", "en": "Good night! (formal)", "ro": "Noapte bună! (formal)", "kind": "phrase"},
        {"hu": "Jó éjszakát!", "en": "Good night!", "ro": "Noapte bună!", "kind": "phrase"},
        {"hu": "Jó éjt!", "en": "Good night! (short)", "ro": "Noapte bună! (scurt)", "kind": "phrase"},
        {"hu": "Nagyon örülök!", "en": "Nice to meet you!", "ro": "Încântat(ă)! / Îmi pare bine!", "note": "Literally: I’m very glad", "kind": "phrase"}
      ]
    },
