        { "hu": "Nem.", "en": "No.", "kind": "phrase" },
        { "hu": "Nem tudom.", "en": "I don’t know.", "kind": "phrase" },
        { "hu": "Fogalmam sincs.", "en": "I have no idea.", "note": "Literally: I don’t even have a concept", "kind": "phrase" },
        { "hu": "Tessék?", "en": "Pardon? Sorry? (I didn’t hear)", "kind": "phrase" },
        { "hu": "Mit mondasz?", "en": "What are you saying? (informal)", "kind": "phrase" },
        { "hu": "Elnézést, nem értem.", "en": "Excuse me, I don’t understand.", "kind": "phrase" },
        { "hu": "Nem értem.", "en": "I don’t understand.", "kind": "phrase" }
      ]
    },
