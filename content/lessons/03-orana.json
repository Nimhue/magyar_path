        { "hu": "Hogy mondják magyarul azt, hogy „chair”?", "en": "How do you say “chair” in Hungarian?", "note": "Literally: how do they say in Hungarian that…", "kind": "phrase" },
        { "hu": "Tessék!", "en": "Here you are! (handing something over)", "note": "Like German “bitte”", "kind": "phrase" },
        { "hu": "Köszönöm.", "en": "Thank you.", "kind": "phrase" },
        { "hu": "Szívesen.", "en": "You’re welcome.", "note": "Also: gladly", "kind": "phrase" },
        { "hu": "Világos minden?", "en": "Is everything clear?", "kind": "phrase" },
