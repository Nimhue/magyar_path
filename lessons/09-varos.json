    {
      "name": "Szabályok · Rules from class",
      "items": [
        {"hu": "alma → almát, iskola → iskolába", "en": "A final -a becomes -á before ANY ending", "ro": "-a finală devine -á înaintea oricărei terminații", "kind": "rule"},
        {"hu": "lecke → leckét, zene → zenében", "en": "A final -e becomes -é before ANY ending", "ro": "-e finală devine -é înaintea oricărei terminații", "kind": "rule"},
        {"hu": "Budapest → Budapesten", "en": "Compound words: ignore the first part, follow the last one (pest)", "ro": "Cuvinte compuse: contează ultima parte (pest)", "kind": "rule"},
        {"hu": "konyhaszekrény → konyhaszekrényben", "en": "konyha + szekrény: szekrény is front, so -ben", "ro": "konyha + szekrény: szekrény e „front”, deci -ben", "kind": "rule"},
        {"hu": "hotel → hotelben", "en": "New loan words: look at the last syllable", "ro": "Împrumuturi noi: contează ultima silabă", "kind": "rule"},
        {"hu": "Péter KÁVÉT iszik.", "en": "Focus: the important (new) part goes right before the verb: Peter drinks COFFEE (not tea).", "ro": "Focus: partea importantă stă chiar înaintea verbului.", "kind": "rule"}
