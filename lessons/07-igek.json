      "name": "Milyen jól? · How well?",
      "items": [
        {"hu": "nagyon jól", "en": "very well", "ro": "foarte bine"},
        {"hu": "jól", "en": "well", "ro": "bine"},
        {"hu": "elég jól", "en": "quite well", "ro": "destul de bine"},
        {"hu": "egy kicsit", "en": "a little", "ro": "puțin"},
        {"hu": "nem", "en": "not (at all)", "ro": "deloc, nu"},
        {"hu": "Tudsz japánul?", "en": "Do you speak Japanese? (informal)", "ro": "Știi japoneză?", "kind": "phrase"},
        {"hu": "Beszél japánul?", "en": "Do you speak Japanese? (formal)", "ro": "Vorbiți japoneză?", "kind": "phrase"},
        {"hu": "Igen, egy kicsit tudok.", "en": "Yes, I can a little.", "ro": "Da, știu puțin.", "kind": "phrase"},
        {"hu": "Igen, elég jól beszélek.", "en": "Yes, I speak it quite well.", "ro": "Da, vorbesc destul de bine.", "kind": "phrase"},
        {"hu": "Sajnos nem. És te?", "en": "Unfortunately not. And you?", "ro": "Din păcate nu. Și tu?", "kind": "phrase"},
        {"hu": "Én is.", "en": "Me too.", "ro": "Și eu.", "note": "answers a positive sentence", "kind": "phrase"},
        {"hu": "Én sajnos nem.", "en": "Unfortunately I don't.", "ro": "Eu, din păcate, nu.", "kind": "phrase"},
        {"hu": "Én sem.", "en": "Me neither.", "ro": "Nici eu.", "note": "answers a negative sentence", "kind": "phrase"},
        {"hu": "Én igen.", "en": "I do. (after a negative)", "ro": "Eu da.", "kind": "phrase"},
        {"hu": "még nem", "en": "not yet", "ro": "încă nu"},
        {"hu": "olyan jól", "en": "that well, so well", "ro": "atât de bine"},
        {"hu": "néha", "en": "sometimes", "ro": "uneori"},
        {"hu": "otthon", "en": "at home", "ro": "acasă"}
      ]
