        {"hu": "Szia! Tamara vagyok.", "en": "Hi! I'm Tamara.", "ro": "Salut! Sunt Tamara.", "kind": "phrase"},
        {"hu": "Jó napot kívánok! John Peters vagyok.", "en": "Good day! I'm John Peters.", "ro": "Bună ziua! Sunt John Peters.", "kind": "phrase"},
        {"hu": "Elnézést, te vagy Kis Balázs?", "en": "Excuse me, are you Balázs Kis? (informal)", "ro": "Scuză-mă, tu ești Balázs Kis?", "kind": "phrase"},
        {"hu": "Elnézést, Ön Kis Balázs?", "en": "Excuse me, are you Balázs Kis? (formal)", "ro": "Scuzați-mă, dumneavoastră sunteți Balázs Kis?", "kind": "phrase"},
        {"hu": "Igen, én vagyok.", "en": "Yes, that's me.", "ro": "Da, eu sunt.", "kind": "phrase"},
        {"hu": "Nem, én Nagy Kornél vagyok.", "en": "No, I'm Kornél Nagy.", "ro": "Nu, eu sunt Kornél Nagy.", "kind": "phrase"},
        {"hu": "Jaj, elnézést!", "en": "Oh, sorry!", "ro": "Vai, scuze!", "kind": "phrase"},
        {"hu": "Semmi baj.", "en": "No problem. / Never mind.", "ro": "Nicio problemă.", "note": "baj = trouble (Romanian “bai” comes from it!)", "kind": "phrase"},
        {"hu": "Én is nagyon örülök.", "en": "Nice to meet you too.", "ro": "Și eu mă bucur foarte mult.", "kind": "phrase"},
        {"hu": "Mutassa be a csoportot!", "en": "Introduce the group! (formal instruction)", "ro": "Prezentați grupul!", "kind": "phrase"},
        {"hu": "Ő Yves, ő Nathalie.", "en": "This is Yves, this is Nathalie.", "ro": "El e Yves, ea e Nathalie.", "note": "ő also means “this person here” when you introduce someone", "kind": "phrase"}
