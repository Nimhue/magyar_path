    {
      "type": "choice",
      "prompt": "számítógép + -ban/-ben = ?",
      "options": [
        "számítógépben",
        "számítógépban"
      ],
      "answer": "számítógépben",
      "explain": "Compound: the last part is gép (front)."
    },
    {
      "type": "choice",
      "prompt": "hotel + -ban/-ben = ?",
      "options": [
        "hotelben",
        "hotelban"
      ],
      "answer": "hotelben",
      "explain": "Loan word: look at the last syllable, -tel."
    },
    {
      "type": "choice",
      "prompt": "Budapest + -n = ?",
      "options": [
        "Budapesten",
        "Budapeston",
        "Budapestben"
