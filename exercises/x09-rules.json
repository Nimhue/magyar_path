      "answer": "Budapesten"
    },
    {
      "type": "choice",
      "prompt": "alma → (accusative) ?",
      "options": [
        "almát",
        "almat",
        "almet"
      ],
      "answer": "almát",
      "explain": "Final a → á before any ending."
    },
    {
      "type": "choice",
      "prompt": "lecke → (accusative) ?",
      "options": [
        "leckét",
        "lecket",
        "leckat"
