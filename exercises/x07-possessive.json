  "title": "-m, -d",
  "titleEn": "My and your",
  "intro": "Vowel at the end: -m/-d. Otherwise -om/-od, -em/-ed or -öm/-öd.",
  "items": [
    { "type": "choice", "prompt": "a férj → my husband", "options": ["a férjem", "a férjom", "a férjöm"], "answer": "a férjem" },
