    { "type": "choice", "prompt": "a sofőr → your driver", "options": ["a sofőröd", "a sofőred", "a sofőrod"], "answer": "a sofőröd", "explain": "ő in the last syllable → -öd." },
    { "type": "choice", "prompt": "az iskola → my school", "options": ["az iskolám", "az iskolam", "az iskolaom"], "answer": "az iskolám", "explain": "a → á, then -m." },
    { "type": "choice", "prompt": "a név → my name", "options": ["a nevem", "a névem", "a névom"], "answer": "a nevem", "explain": "Irregular." },
    { "type": "choice", "prompt": "a ház → my house", "options": ["a házam", "a házom", "a házem"], "answer": "a házam" },
    { "type": "choice", "prompt": "a szám → my number", "options": ["a számom", "a számam", "a számem"], "answer": "a számom", "explain": "Unlike ház → házam. Learn these one by one." },
    { "type": "choice", "prompt": "az anyanyelv → my mother tongue", "options": ["az anyanyelvem", "az anyanyelvom", "az anyanyelvam"], "answer": "az anyanyelvem", "explain": "Compound: the last word (nyelv) decides." },
    { "type": "choice", "prompt": "a hotel → my hotel", "options": ["a hotelem", "a hotelom", "a hotelöm"], "answer": "a hotelem", "explain": "Foreign word: the last vowel (e) decides." },
